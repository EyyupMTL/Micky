<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◉ Micky"
                android:textColor="@color/accent"
                android:textSize="28sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="telefonunu mikrofona çevir"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:gravity="center_vertical|start"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/mismatchBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/banner_warn"
            android:textColor="#ffb3b3"
            android:textSize="13sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Hazır"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/bigStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Yayın kapalı"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <com.micky.phone.MicOrbView
            android:id="@+id/micOrb"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:contentDescription="Sessize almak için dokun"/>

        <TextView
            android:id="@+id/orbHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="sessize almak için dokun"
            android:textColor="@color/text_dim"
            android:textSize="12sp"/>

        <com.micky.phone.VuView
            android:id="@+id/vu"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/panel"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SES EFEKTİ"
                    android:textColor="@color/accent_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"/>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/fxChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="6dp"
                        android:singleLine="true"/>
                </HorizontalScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/panel"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BAĞLANTI MODU"
                    android:textColor="@color/accent_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"/>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/modeChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacingHorizontal="6dp">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWifi"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wi-Fi"
                        android:checked="true"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/panel_light"
                        app:checkedIconTint="@color/accent"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUsb"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USB"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/panel_light"
                        app:checkedIconTint="@color/accent"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDirect"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wi-Fi Direct"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/panel_light"
                        app:checkedIconTint="@color/accent"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBt"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bluetooth"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/panel_light"
                        app:checkedIconTint="@color/accent"/>
                </com.google.android.material.chip.ChipGroup>
                <TextView
                    android:id="@+id/targetText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/border"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SES SEVİYESİ"
                        android:textColor="@color/accent_dim"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:id="@+id/gainValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.00×"
                        android:textColor="@color/text"
                        android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/gainSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:valueFrom="0.0"
                    android:valueTo="3.0"
                    android:stepSize="0.05"
                    android:value="1.0"
                    app:thumbColor="@color/accent"
                    app:trackColorActive="@color/accent"
                    app:trackColorInactive="@color/panel_light"
                    app:haloColor="@color/accent"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Yayını başlat"
            android:textColor="@color/black_ink"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:icon="@drawable/ic_mic"
            app:iconTint="@color/black_ink"
            app:backgroundTint="@color/accent"
            app:cornerRadius="14dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
    </LinearLayout>
</ScrollView>
